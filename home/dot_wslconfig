# ~/.wslconfig

# Settings apply across all Linux distros running on WSL 2
[wsl2]
guiApplications=true
memory=32GB
processors=16
swap=0
localhostForwarding=true

# https://learn.microsoft.com/en-us/windows/wsl/networking#dns-tunneling
# NOTE: The Global Secure Access client auto-disables DNS tunneling
# ("DNS Tunneling is disabled" on boot), so it cannot fix DNS here.
# Mirrored mode below inherits the Windows host's (working) DNS instead.
# dnsTunneling=true

# https://learn.microsoft.com/en-us/windows/wsl/networking#mirrored-mode-networking
networkingMode=mirrored

# https://github.com/microsoft/WSL/issues/11980#issuecomment-2412350798
# networkingMode=virtioProxy

# Turns on output console showing contents of dmesg when opening a WSL 2 distro for debugging
# debugConsole=true

# Enable experimental features
[experimental]
autoMemoryReclaim=gradual
sparseVhd=true
bestEffortDnsParsing=true
