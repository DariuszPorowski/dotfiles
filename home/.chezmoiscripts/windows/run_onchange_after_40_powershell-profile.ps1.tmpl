# hash: {{ include (joinPath .chezmoi.sourceDir ".chezmoitemplates/powershell_profile.ps1") | sha256sum }}
# VS Code seed: {{ include (joinPath .chezmoi.sourceDir "dot_config/powershell/create_Microsoft.VSCode_profile.ps1") | sha256sum }}

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$homeDir = [IO.Path]::GetFullPath('{{ .chezmoi.destDir | replace "'" "''" }}')
$source = Join-Path $homeDir '.config\powershell'
$destinations = @(
    (Join-Path $homeDir 'Documents\PowerShell')
    (Join-Path $homeDir 'Documents\WindowsPowerShell')
)
$profileDir = [Environment]::GetFolderPath('UserProfile')
if ($profileDir -and $homeDir -eq [IO.Path]::GetFullPath($profileDir)) {
    $documents = [Environment]::GetFolderPath('MyDocuments')
    if ($documents) {
        $destinations += Join-Path $documents 'PowerShell'
        $destinations += Join-Path $documents 'WindowsPowerShell'
    }
    if ($env:OneDriveCommercial) {
        $destinations += Join-Path $env:OneDriveCommercial 'Documents\PowerShell'
        $destinations += Join-Path $env:OneDriveCommercial 'Documents\WindowsPowerShell'
    }
}
if (-not (Test-Path -LiteralPath $source -PathType Container)) {
    throw "Source directory not found: $source"
}
foreach ($dest in ($destinations | Select-Object -Unique)) {
    $null = [IO.Directory]::CreateDirectory($dest)
    Get-ChildItem -LiteralPath $source -Filter '*.ps1' -File | ForEach-Object {
        $destFilePath = Join-Path $dest $_.Name
        if ($_.Name -eq 'Microsoft.VSCode_profile.ps1') {
            # Seed the extension's host-specific profile without overwriting user customizations.
            if (-not (Test-Path -LiteralPath $destFilePath)) {
                [IO.File]::Copy($_.FullName, $destFilePath)
            }
        } elseif (-not (Test-Path -LiteralPath $destFilePath) -or
            (Get-FileHash -LiteralPath $_.FullName).Hash -ne (Get-FileHash -LiteralPath $destFilePath).Hash) {
            Write-Host "Copying $($_.Name) to $dest"
            Copy-Item -LiteralPath $_.FullName -Destination $destFilePath -Force
        }
    }
}
