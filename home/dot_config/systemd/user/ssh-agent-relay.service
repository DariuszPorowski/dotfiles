[Unit]
Description=1Password SSH Agent Relay

[Service]
RuntimeDirectory=dotfiles-ssh
RuntimeDirectoryMode=0700
UMask=0077
Environment="PATH=%h/.local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/socat "UNIX-LISTEN:%t/dotfiles-ssh/agent.sock,fork,mode=0600" "EXEC:npiperelay -ei -s //./pipe/openssh-ssh-agent,nofork"
Restart=on-failure
RestartSec=10
TimeoutStartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
