---
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - name: Disable the Windows OpenSSH agent
    type: Microsoft.Windows/Service
    metadata:
      winget:
        securityContext: elevated
    properties:
      name: ssh-agent
      startType: Disabled
      status: Stopped
