{{- if .machine.wsl -}}
#!/bin/sh
set -eu
"$HOME/.local/bin/npiperelay-symlink.sh"
if systemctl --user show-environment >/dev/null 2>&1; then
  systemctl --user daemon-reload
  systemctl --user enable --now ssh-agent-relay.service
else
  echo "User systemd is unavailable; the WSL SSH relay will start from the interactive shell." >&2
fi
{{- end }}
